{% extends 'basefront.html.twig' %}

{% block title %}Administration | {{ parent() }}{% endblock %}

{% block top %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-start">
            <!-- menu -->
            <div class="text-left">
                <img src="{{ app.request.getBasePath() ~ '/banniere.jpg' }}" alt="Bannière du site">
            </div>

            {% if app.user %}
                <div class="mt-2">
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">
                        Se déconnecter
                    </a>
                </div>
            {% endif %}
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin.index') }}">Accueil admin</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin.formations.index') }}">Formations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin.playlists.index') }}">Playlists</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin.categories.index') }}">Catégories</a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
{% endblock %}

{% block body %}{% endblock %}
