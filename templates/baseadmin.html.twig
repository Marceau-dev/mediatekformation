{% extends 'basefront.html.twig' %}

{% block title %}Administration | {{ parent() }}{% endblock %}

{% block top %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-start">
            <!-- menu -->
            <div class="text-left">
                <img src="{{ app.request.getBasePath() ~ '/banniere.jpg' }}" alt="Bannière du site">
            </div>

            {% if app.user %}
                <div class="mt-2">
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">
                        Se déconnecter
                    </a>
                </div>
            {% endif %}
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Afficher le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link ms-2" href="{{ path('admin.index') }}">Accueil admin</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ms-2" href="{{ path('admin.formations.index') }}">Formations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ms-2" href="{{ path('admin.playlists.index') }}">Playlists</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ms-2" href="{{ path('admin.categories.index') }}">Catégories</a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
{% endblock %}

{% block body %}{% endblock %}
